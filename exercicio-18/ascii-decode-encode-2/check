#!/usr/bin/exec-suid -- /bin/bash -p
RESP="/home/hacker/resposta.txt"
ESPERADO=$'BUS\n4\n0x44:01000100 0x61:01100001 0x76:01110110 0x69:01101001'

if [ ! -f "$RESP" ]; then
    echo "Arquivo resposta.txt não encontrado no seu diretório home!"
    exit 1
fi

OBTIDO=$(cat "$RESP")

if [ "$OBTIDO" == "$ESPERADO" ]; then
    echo "Correto! Flag:"
    cat /flag
else
    echo "Resposta incorreta."
    echo "Esperado (linha 1: sigla | linha 2: bytes | linha 3: HEX:BINARIO por caractere):"
    echo "$ESPERADO"
    echo ""
    echo "Obtido:"
    echo "$OBTIDO"
fi
