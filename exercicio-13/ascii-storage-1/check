#!/usr/bin/exec-suid -- /bin/bash -p
RESP="/home/hacker/resposta.txt"
ESPERADO=$'9\n80 114 111 99 101 115 115 111 114'

if [ ! -f "$RESP" ]; then
    echo "Arquivo resposta.txt não encontrado no seu diretório home!"
    exit 1
fi

OBTIDO=$(cat "$RESP")

if [ "$OBTIDO" == "$ESPERADO" ]; then
    echo "Correto! Flag:"
    cat /flag
else
    echo "Resposta incorreta."
    echo "Esperado (linha 1: bytes | linha 2: codigos ASCII decimais):"
    echo "$ESPERADO"
    echo ""
    echo "Obtido:"
    echo "$OBTIDO"
fi
