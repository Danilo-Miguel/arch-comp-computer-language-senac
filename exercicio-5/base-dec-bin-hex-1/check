#!/usr/bin/exec-suid -- /bin/bash -p
RESP="/home/hacker/resposta.txt"
ESPERADO=$'0xC6\n0x5B\n0x57\n0xE3'

if [ ! -f "$RESP" ]; then
    echo "Arquivo resposta.txt não encontrado no seu diretório home!"
    exit 1
fi

OBTIDO=$(cat "$RESP")

if [ "$OBTIDO" == "$ESPERADO" ]; then
    echo "Correto! Flag:"
    cat /flag
else
    echo "Resposta incorreta."
    echo "Esperado (4 linhas, uma por item a-d, formato '0xXX' maiúsculo):"
    echo "$ESPERADO"
    echo ""
    echo "Obtido:"
    echo "$OBTIDO"
fi
