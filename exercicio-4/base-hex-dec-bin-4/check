#!/usr/bin/exec-suid -- /bin/bash -p
RESP="/home/hacker/resposta.txt"
ESPERADO=$'21 00010101\n43 00101011\n71 01000111\n140 10001100'

if [ ! -f "$RESP" ]; then
    echo "Arquivo resposta.txt não encontrado no seu diretório home!"
    exit 1
fi

OBTIDO=$(cat "$RESP")

if [ "$OBTIDO" == "$ESPERADO" ]; then
    echo "Correto! Flag:"
    cat /flag
else
    echo "Resposta incorreta."
    echo "Esperado (4 linhas, formato 'DECIMAL BINARIO'):"
    echo "$ESPERADO"
    echo ""
    echo "Obtido:"
    echo "$OBTIDO"
fi
